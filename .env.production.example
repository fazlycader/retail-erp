# ============================================================================================
#  PRODUCTION .env for Hostinger. Copy to ~/domains/<domain>/app/shared/.env on the server
#  (docs/DEPLOYMENT.md §7). Never commit the real file. The app refuses to start in production
#  if APP_KEY, APP_DEBUG, APP_URL, the database, queue/cache/session drivers or mail are wrong.
# ============================================================================================

# --- App ------------------------------------------------------------------------------------
APP_NAME="Teak House ERP"
APP_ENV=production
# Generate on the server:  echo "base64:$(openssl rand -base64 32)"   and paste the result here.
# Never change it later: it encrypts sessions, 2FA secrets and cookies.
APP_KEY=
APP_DEBUG=false
# Your live address, with https:// and no trailing slash.
APP_URL=https://erp.example.lk
APP_TIMEZONE=Asia/Colombo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- Security -------------------------------------------------------------------------------
# Two-factor login for admins and accountants (leave true in production).
REQUIRE_TWO_FACTOR=true
# Hostinger CDN ON → TRUSTED_PROXIES=REMOTE_ADDR. CDN OFF → leave empty.
TRUSTED_PROXIES=
FORCE_HTTPS=true
SECURITY_CSP=true
# Long random strings (e.g. openssl rand -hex 32). Also saved as GitHub secrets.
HEALTH_TOKEN=
OPCACHE_RESET_TOKEN=
BCRYPT_ROUNDS=12

# --- Database (hPanel → Databases → MySQL Databases) ----------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_erp
DB_USERNAME=u123456789_erp
DB_PASSWORD=

# --- Sessions, cache, queue (shared hosting: no Redis, no Supervisor) ------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
CACHE_PREFIX=erp_
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Logs: one file per day, kept 14 days ---------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# --- Mail (hPanel → Emails → create invoices@yourdomain; Hostinger SMTP) ---------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=invoices@erp.example.lk
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=invoices@erp.example.lk
MAIL_FROM_NAME="${APP_NAME}"

# --- Alerts -----------------------------------------------------------------------------------
# Unexpected errors are emailed here (at most once per error every ERROR_ALERT_MINUTES).
ERROR_ALERT_EMAIL=owner@example.lk
ERROR_ALERT_MINUTES=15

# --- Uploaded images -------------------------------------------------------------------------
# Normally empty (public/storage is a symlink made by the deploy). Only if Hostinger refuses
# symlinks: PUBLIC_DISK_URL=https://erp.example.lk/storage (served by the fallback route).
PUBLIC_DISK_ROOT=
PUBLIC_DISK_URL=

# --- Backups (spatie/laravel-backup → any S3-compatible bucket; docs §15) --------------------
# Backblaze B2: endpoint https://s3.<region>.backblazeb2.com, region e.g. eu-central-003.
# Cloudflare R2: endpoint https://<account>.r2.cloudflarestorage.com, region auto.
# Leave BACKUP_S3_BUCKET empty to keep backups on the server only (storage/app/backups).
BACKUP_NAME=retail-erp
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_PATH_STYLE=true
BACKUP_ALERT_EMAIL=owner@example.lk
# Hostinger: path to mysqldump if `which mysqldump` is not on the cron PATH (usually /usr/bin).
DB_DUMP_BINARY_PATH=

# --- MVRK+ credit (sidebar, sign-in and lock screens) ---------------------------------------
# BRAND_CREDIT=false hides every "Powered by MVRK+" line (white-label clients).
BRAND_CREDIT=true
BRAND_NAME="MVRK+"
BRAND_PRODUCT="MVRK+ ERP"
BRAND_WEBSITE=mvrk.lk
BRAND_WHATSAPP="+94 789 818 815"

VITE_APP_NAME="${APP_NAME}"
